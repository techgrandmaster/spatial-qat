# Meta Model API
MODEL_API_KEY=your_meta_api_key_here
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs (defaults)
MODEL_SPARK=muse-spark-1.3
MODEL_SAM=sam-3.1
MODEL_VOICE=muse-voice-transcribe-1.0
MODEL_IMAGE=muse-image-1.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spatial_qat

# Budget guard
BUDGET_USD_HARD_CAP=120.0

# SAM concurrency
MAX_SAM_CONCURRENCY=4

# Agent loop
AGENT_MAX_STEPS=8
AGENT_MAX_PARALLEL_TOOLS=6
AGENT_TIMEOUT_SECONDS=90

# Upload limits
MAX_IMAGE_SIZE_MB=10
MAX_PDF_SIZE_MB=20
MAX_AUDIO_SIZE_MB=10

# Public base URL used to build absolute asset URLs for external model APIs.
# In production behind a public host, set this to the public backend origin.
PUBLIC_BASE_URL=http://localhost:8000

# Session
GUEST_SESSION_TTL_DAYS=7

# CORS (JSON array format for pydantic-settings)
CORS_ORIGINS='["http://localhost:3000"]'
